# Copy to .env and adjust values for local Docker Compose runs.
# .env is optional; compose falls back to the defaults below when absent.

AI_RUNTIME_ENVIRONMENT=development
AI_RUNTIME_DEBUG=true
AI_RUNTIME_LOG_LEVEL=INFO

# Required for POST /v1/responses against OpenAI.
AI_RUNTIME_OPENAI_API_KEY=

# Optional override for OpenAI-compatible endpoints.
# AI_RUNTIME_OPENAI_BASE_URL=https://api.openai.com/v1
