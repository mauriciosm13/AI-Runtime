# Copy to .env and adjust values for local Docker Compose runs.
# .env is optional; compose falls back to service defaults when absent.

AI_RUNTIME_ENVIRONMENT=development
AI_RUNTIME_DEBUG=true
AI_RUNTIME_LOG_LEVEL=INFO

# Required for POST /v1/responses against OpenAI.
AI_RUNTIME_OPENAI_API_KEY=

# Optional override for OpenAI-compatible endpoints.
# AI_RUNTIME_OPENAI_BASE_URL=https://api.openai.com/v1

# Required for Claude catalog models (e.g. claude-3-5-sonnet-20241022).
# When blank, Anthropic is not registered and those models return HTTP 503.
AI_RUNTIME_ANTHROPIC_API_KEY=

# Optional override for Anthropic-compatible endpoints.
# AI_RUNTIME_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Async SQLAlchemy URL (postgresql+asyncpg required).
# Compose overrides this to use the postgres service hostname.
# For host-side uvicorn against published Compose Postgres, use localhost:
AI_RUNTIME_DATABASE_URL=postgresql+asyncpg://ai_runtime:ai_runtime@localhost:5432/ai_runtime

# Redis URL for rate limiting and idempotency (redis:// or rediss://).
# Compose overrides this to use the redis service hostname.
# For host-side uvicorn against published Compose Redis, use localhost:
AI_RUNTIME_REDIS_URL=redis://localhost:6379/0

# Platform default token-bucket rate limit (per organization).
# AI_RUNTIME_RATE_LIMIT_REQUESTS_PER_MINUTE=60
# AI_RUNTIME_RATE_LIMIT_BURST=60

# Idempotency-Key retention in seconds (default 24h).
# AI_RUNTIME_IDEMPOTENCY_TTL_SECONDS=86400
